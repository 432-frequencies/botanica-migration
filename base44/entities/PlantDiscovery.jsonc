{
  "name": "PlantDiscovery",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "plant",
        "bird",
        "rock",
        "fungus",
        "tree",
        "insect"
      ],
      "default": "plant",
      "description": "Type of specimen"
    },
    "is_cannabis": {
      "type": "boolean",
      "default": false
    },
    "strain_type": {
      "type": "string",
      "enum": [
        "sativa",
        "indica",
        "hybrid",
        "autoflowering",
        ""
      ],
      "default": ""
    },
    "common_name": {
      "type": "string"
    },
    "scientific_name": {
      "type": "string"
    },
    "family": {
      "type": "string"
    },
    "photo_url": {
      "type": "string"
    },
    "thumbnail_url": {
      "type": "string"
    },
    "rarity": {
      "type": "string",
      "enum": [
        "commune",
        "peu_commune",
        "rare",
        "legendaire"
      ],
      "default": "commune"
    },
    "is_edible": {
      "type": "boolean",
      "default": false
    },
    "is_toxic": {
      "type": "boolean",
      "default": false
    },
    "biome": {
      "type": "string",
      "enum": [
        "foret",
        "prairie",
        "montagne",
        "bord_eau",
        "urban",
        "cote",
        "inconnu"
      ],
      "default": "inconnu"
    },
    "description": {
      "type": "string"
    },
    "edibility_details": {
      "type": "string"
    },
    "medicinal_uses": {
      "type": "string"
    },
    "anecdote": {
      "type": "string"
    },
    "habitat": {
      "type": "string"
    },
    "behavior": {
      "type": "string"
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "location_name": {
      "type": "string"
    },
    "confidence": {
      "type": "number"
    },
    "api_data": {
      "type": "object"
    },
    "points_earned": {
      "type": "number",
      "default": 10
    },
    "discovered_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "user_email",
    "common_name"
  ]
}