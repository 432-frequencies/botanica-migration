{
  "name": "UserTrustScore",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "trust_score": {
      "type": "number",
      "default": 100,
      "minimum": 0,
      "maximum": 100
    },
    "violations": {
      "type": "object",
      "properties": {
        "speed_anomalies": {
          "type": "number",
          "default": 0
        },
        "spam_incidents": {
          "type": "number",
          "default": 0
        },
        "farming_attempts": {
          "type": "number",
          "default": 0
        },
        "suspicious_patterns": {
          "type": "number",
          "default": 0
        }
      }
    },
    "last_violation": {
      "type": "string",
      "format": "date-time"
    },
    "blocked_until": {
      "type": "string",
      "format": "date-time"
    },
    "surveillance_active": {
      "type": "boolean",
      "default": false
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "user_email"
  ]
}